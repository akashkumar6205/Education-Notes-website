### ============================================
### VARIABLES
### ============================================

@baseUrl = http://localhost:5000/api
@token = 
@adminToken = 
@noteId = 
@subjectId = 

### ============================================
### 1. AUTHENTICATION TESTS
### ============================================

### Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "password123",
  "confirmPassword": "password123"
}

### Login as regular user
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "password123"
}

### Login as admin (with secret key)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "password123",
  "adminKey": "admin_secret_password_123"
}

### Get current user (requires token)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### ============================================
### 2. SUBJECT TESTS
### ============================================

### Get all subjects
GET {{baseUrl}}/subjects

### Get subjects by semester
GET {{baseUrl}}/subjects/semester/2

### Create subject (admin only)
# @name createSubject
POST {{baseUrl}}/subjects
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Data Structures",
  "code": "CS201",
  "semester": 2,
  "description": "Learn about arrays, linked lists, trees, graphs"
}

### Update subject (admin only)
PUT {{baseUrl}}/subjects/{{subjectId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Data Structures & Algorithms",
  "description": "Updated description"
}

### Delete subject (admin only)
DELETE {{baseUrl}}/subjects/{{subjectId}}
Authorization: Bearer {{adminToken}}

### ============================================
### 3. NOTE TESTS - CRUD OPERATIONS
### ============================================

### Get all notes
GET {{baseUrl}}/notes

### Get all notes with pagination
GET {{baseUrl}}/notes?page=1&limit=10

### Get notes with search filter
GET {{baseUrl}}/notes?search=arrays&page=1&limit=10

### Get notes by subject
GET {{baseUrl}}/notes?subject={{subjectId}}&page=1

### Get notes by topic
GET {{baseUrl}}/notes?topic=Arrays&page=1

### Get single note by ID
GET {{baseUrl}}/notes/{{noteId}}

### Create note (admin only)
# @name createNote
POST {{baseUrl}}/notes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Introduction to Arrays",
  "content": "Arrays are contiguous memory structures that store elements of the same type. They provide O(1) random access but have fixed size.",
  "subject": "{{subjectId}}",
  "topic": "Arrays",
  "tags": ["Important", "Exam", "Basics"]
}

### Update note (admin only)
PUT {{baseUrl}}/notes/{{noteId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Arrays - Updated",
  "content": "Updated content with more details...",
  "topic": "Arrays & Sorting",
  "tags": ["Important", "Exam"]
}

### Delete note (admin only)
DELETE {{baseUrl}}/notes/{{noteId}}
Authorization: Bearer {{adminToken}}

### Archive note (soft delete)
PATCH {{baseUrl}}/notes/{{noteId}}/archive
Authorization: Bearer {{adminToken}}

